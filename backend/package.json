{
  "name": "nqs-backend",
  "version": "1.0.0",
  "description": "National Queue System (NQS) National ID Appointment API",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "build": "prisma generate",
    "dev": "node scripts/free-port.cjs 5005 && nodemon server.js",
    "seed": "node utils/seed.js",
    "sync:citizens": "node scripts/sync-citizens-from-users.js",
    "sync:account-profiles": "node scripts/sync-account-profiles-from-users.js",
    "cleanup:orphans": "node scripts/cleanup-orphan-database.js",
    "cleanup:orphans:apply": "node scripts/cleanup-orphan-database.js --apply",
    "cleanup:runtime": "node scripts/cleanup-runtime-noise.js",
    "purge:centers": "node scripts/purge-centers.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-validator": "^7.3.2",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "nodemailer": "^9.0.1",
    "pg": "^8.22.0",
    "prisma": "^7.9.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
