# JWT signing secret for login tokens.
# Use a long, random value in real deployment.
JWT_SECRET=

PORT=5001
FRONTEND_URL=http://localhost:5173

# PostgreSQL database used by Prisma.
# Example: postgresql://postgres:PASSWORD@localhost:5433/nqs
DATABASE_URL=
POSTGRES_SSL=false

# Gmail SMTP settings.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Your Gmail address, for example: myemail@gmail.com
SMTP_USER=

# Your Gmail App Password, not your normal Gmail password.
# Generate it from Google Account > Security > 2-Step Verification > App passwords.
SMTP_PASS=

# Sender name and email shown to users.
# Example: NQS National ID <myemail@gmail.com>
SMTP_FROM=

# Tabaarak SMS API settings for OTP delivery.
SMS_PROVIDER_URL=https://sms.tabaarak.com
SMS_LOGIN_ENDPOINT=/Auth/SMSLogin
SMS_SEND_ENDPOINT=/Sms/sendsms
SMS_USERNAME=
SMS_PASSWORD=
SMS_SENDER_ID=NQS
SMS_LOGIN_USERNAME_FIELD=Name
SMS_LOGIN_PASSWORD_FIELD=Password
SMS_TOKEN_FIELD=token
SMS_TO_FIELD=mobile
SMS_TO_ARRAY=true
SMS_STRIP_COUNTRY_CODE=true
SMS_MESSAGE_FIELD=smsMessage
SMS_SENDER_FIELD=senderId
SMS_INCLUDE_SENDER=false
SMS_BODY_WRAPPER=

# Optional extra secret used when hashing OTP codes.
OTP_SECRET=
