# Base URL of the existing NQS backend (no trailing slash).
# The backend listens on the port defined in backend/.env (PORT=5005).
#
# Android emulator  -> http://10.0.2.2:5005   (loopback of the host machine)
# iOS simulator     -> http://localhost:5005
# Physical device   -> http://<your-computer-LAN-IP>:5005
# Staging / prod    -> https://api.your-domain.example
#
# When API_BASE_URL points at localhost/127.0.0.1 the app rewrites it to
# 10.0.2.2 automatically on Android emulators, so the value below works
# for both simulators without edits.
API_BASE_URL=http://localhost:5005

# Enable Socket.IO live queue updates. When false the app falls back to
# HTTP polling only (the app polls regardless, sockets are an enhancement).
ENABLE_REALTIME=true

# Verbose Dio request/response logging in debug builds.
ENABLE_HTTP_LOGS=true
